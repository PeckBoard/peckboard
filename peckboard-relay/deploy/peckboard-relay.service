[Unit]
Description=Peckboard rendezvous relay (handshake-only)
Documentation=https://github.com/PeckBoard/peckboard/tree/main/peckboard-relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=peckrelay
Group=peckrelay
# Optional extra flags (e.g. PECKRELAY_ARGS=--acme-staging) and
# PECKRELAY_ACME_CONTACT live in /etc/peckboard-relay.env (root, 0600).
EnvironmentFile=-/etc/peckboard-relay.env
ExecStart=/opt/peckboard-relay/peckboard-relay --domain relay.peckboard.com --listen [::]:443 --stun-listen [::]:3478 $PECKRELAY_ARGS
# Local-only admin: `systemctl kill -s USR1 peckboard-relay` toggles debug logs.
Restart=on-failure
RestartSec=2
TimeoutStopSec=10
Environment=RUST_LOG=info

# State (ACME account + cert cache) — the only thing ever written to disk.
# systemd exports $STATE_DIRECTORY, which the binary uses as --state-dir.
StateDirectory=peckrelay
StateDirectoryMode=0700
UMask=0077

# Bind :443 without root; no other capability.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM

LimitNOFILE=16384
MemoryMax=512M
TasksMax=256

[Install]
WantedBy=multi-user.target

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Merged into the generated iOS Info.plist by the Tauri CLI. -->
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>PeckBoard</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>PeckBoard uses the microphone for voice conversations with your agents.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>PeckBoard turns what you say into text for your agents.</string>
	<key>NSCameraUsageDescription</key>
	<string>PeckBoard uses the camera to scan your box's pairing QR code.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>PeckBoard connects directly to your box when it is on the same network.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>PeckBoard uses Face ID to unlock the app.</string>
	<!-- Plain HTTP only to the in-app loopback tunnel (127.0.0.1); no arbitrary loads. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- Standard crypto only (TLS 1.3 / QUIC via the OS and rustls): exempt, so
	     TestFlight uploads skip the export-compliance prompt. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>

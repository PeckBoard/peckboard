<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: keep pairing data out of cloud backup and device transfer.
     (The Keystore key never migrates anyway, so copied ciphertext would be
     unreadable; excluding it avoids a half-restored box list.) -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
